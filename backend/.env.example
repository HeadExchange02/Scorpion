# Copy to backend/.env. Never commit real values.

NODE_ENV=development
PORT=4000
APP_URL=http://localhost:3000
API_URL=http://localhost:4000

# Database (Supabase). DATABASE_URL = pooled, DIRECT_URL = direct (migrations, job queue)
DATABASE_URL=
DIRECT_URL=

# Auth (Better Auth)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Master key for encrypting client API keys at rest (32 random bytes, base64). Keep outside the database.
ENCRYPTION_MASTER_KEY=

# n8n (server-side only, never exposed to the browser)
N8N_BASE_URL=
N8N_API_KEY=

# Shared secret used to sign usage pings from n8n workflows to /internal/usage
USAGE_WEBHOOK_SECRET=

# Supabase Storage
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Email (OTP codes and notifications)
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=

# Platform AI provider key (used when a client does not bring their own)
PLATFORM_LLM_API_KEY=

# Payments (Bkash, Nagad, crypto): variables are added in Phase 2 once merchant accounts are confirmed.
