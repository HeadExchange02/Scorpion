{
  "name": "scorpion",
  "version": "0.0.0",
  "private": true,
  "description": "Scorpion SaaS: multi-tenant control plane for n8n AI workflows",
  "workspaces": [
    "backend",
    "frontend",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "dev:worker": "npm run dev:worker -w backend",
    "install:all": "npm install",
    "build": "npm run build -w frontend",
    "lint": "npm run lint --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "devDependencies": {
    "concurrently": "^10.0.7"
  },
  "engines": {
    "node": ">=22"
  }
}
